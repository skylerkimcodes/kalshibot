# Copy this file to .env and fill in your values.
# Demo keys: https://demo.kalshi.co/account/profile
# Prod keys: https://kalshi.com/account/profile

KALSHI_API_KEY_ID=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=./kalshi_demo_private_key.pem

# demo | prod
KALSHI_ENV=demo

# Crypto 15m Up/Down (KX{ASSET}15M)
CRYPTO15M_ASSETS=BTC,ETH,SOL,XRP,DOGE,BNB,HYPE
# Min fair − ask to take a trade (dollars of probability)
CRYPTO15M_MIN_EDGE=0.04
CRYPTO15M_MAX_CONTRACTS=5
CRYPTO15M_LOOP_SECONDS=5
# Skip windows with fewer seconds remaining
CRYPTO15M_MIN_SECONDS_LEFT=75
CRYPTO15M_MAX_SESSION_TRADES=20
CRYPTO15M_MAX_SPEND=50
